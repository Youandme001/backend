PORT=4000
# URL publique de l'API (sert à construire les liens des images)
PUBLIC_URL=http://localhost:4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=glowy

# Chaîne longue et aléatoire, jamais commitée
JWT_SECRET=change-me

# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frais de livraison en TND
SHIPPING_FEE=8

# true une seule fois pour ajouter les nouvelles colonnes à une base existante
DB_SYNC_ALTER=false
